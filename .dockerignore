# .dockerignore
# Keep secrets and junk out of the image entirely.

.env
.env.*
.git
.gitignore

__pycache__/
*.py[cod]
*.pyc

# Regenerated fresh during the image build via collectstatic - don't ship stale copies.
staticfiles/

media/
logs/
*.log

venv/
env/
.venv/
*.sqlite3

# Superseded by Dockerfile - no longer used, safe to exclude even if not deleted yet.
build.sh
apt.txt

.pytest_cache/
.mypy_cache/
.vscode/
.idea/