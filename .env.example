# Copy this to .env locally, or set these as environment variables in
# your host's dashboard (e.g. Render -> your service -> Environment).

# --- Email (contact form + password reset) ---
# Render's free web services block outbound SMTP, so email is sent over
# Brevo's HTTPS API instead (see core/email_backends.py for why + setup).
# Free plan, no credit card: https://www.brevo.com
BREVO_API_KEY=
# Must be a sender address you've verified inside Brevo (Settings -> Senders).
DEFAULT_FROM_EMAIL=

# --- AI extraction + chat (Google Gemini free tier) ---
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
